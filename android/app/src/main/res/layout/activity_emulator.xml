<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161616"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/btn_open"
                style="@style/MgbaButton"
                android:text="@string/open_rom" />

            <Button
                android:id="@+id/btn_pause"
                style="@style/MgbaButton"
                android:text="@string/pause" />

            <Button
                android:id="@+id/btn_fast"
                style="@style/MgbaButton"
                android:text="@string/speed_1" />

            <Button
                android:id="@+id/btn_reset"
                style="@style/MgbaButton"
                android:text="@string/reset" />

            <Button
                android:id="@+id/btn_slot"
                style="@style/MgbaButton"
                android:text="@string/slot_initial" />

            <Button
                android:id="@+id/btn_save"
                style="@style/MgbaButton"
                android:text="@string/save_state" />

            <Button
                android:id="@+id/btn_load"
                style="@style/MgbaButton"
                android:text="@string/load_state" />

            <Button
                android:id="@+id/btn_bios"
                style="@style/MgbaButton"
                android:text="@string/bios" />

            <Button
                android:id="@+id/btn_video"
                style="@style/MgbaButton"
                android:text="@string/video" />

            <Button
                android:id="@+id/btn_link"
                style="@style/MgbaButton"
                android:text="@string/link" />

            <TextView
                android:id="@+id/fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#9CCC9C"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/save_path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12281A"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="#B7E3B7"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <io.mgba.android.GameView
            android:id="@+id/game"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/hint"
            android:textColor="#DDDDDD"
            android:textSize="16sp" />

        <io.mgba.android.ControlsView
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>
</LinearLayout>
