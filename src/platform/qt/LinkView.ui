     <x>300</x>
     <y>300</y>
    </hint>
    <hint type="destinationlabel">
     <x>180</x>
     <y>160</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>radioJoin</sender>
   <signal>toggled(bool)</signal>
   <receiver>ipAddr</receiver>
   <slot>setEnabled(bool)</slot>
   <hints>
